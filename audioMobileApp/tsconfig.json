{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "jsx": "react-native",
    "types": ["node"],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@onemelody/api": [
        "../packages/api/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "nativewind-env.d.ts"
  ]
}
